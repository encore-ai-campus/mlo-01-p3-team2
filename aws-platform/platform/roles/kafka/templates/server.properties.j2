# Ansible로 관리한다 (roles/kafka). KRaft combined 모드.
process.roles=broker,controller
node.id={{ kafka_node_id }}
controller.quorum.voters={% for h in groups['kafka'] %}{{ h | regex_search('[0-9]+$') }}@{{ hostvars[h].ip }}:{{ kafka_controller_port }}{{ ',' if not loop.last }}{% endfor %}

controller.listener.names=CONTROLLER
listeners=BROKER://{{ ip }}:{{ kafka_broker_port }},CONTROLLER://{{ ip }}:{{ kafka_controller_port }}
advertised.listeners=BROKER://{{ ip }}:{{ kafka_broker_port }}
inter.broker.listener.name=BROKER
listener.security.protocol.map=BROKER:PLAINTEXT,CONTROLLER:PLAINTEXT

log.dirs={{ kafka_data_dir }}
num.partitions=3
default.replication.factor=3
min.insync.replicas=2
offsets.topic.replication.factor=3
transaction.state.log.replication.factor=3
transaction.state.log.min.isr=2
auto.create.topics.enable=false
group.initial.rebalance.delay.ms=0
