# Ansible로 관리한다 (roles/firewall). 전용 테이블 하나만 관리하며 다른 도구의 규칙은 건드리지 않는다.
# 테이블을 비우고 다시 만드는 것을 한 번의 트랜잭션으로 적용한다 (nft -f).
{% set ssh_ips = [] %}
{% set restricted = account1_service_restricted | default(false) | bool %}
{% for g in (['bastion'] if restricted else firewall_ssh_sources) %}
{% for h in groups.get(g, []) %}
{% set _ = ssh_ips.append(hostvars[h].ip) %}
{% endfor %}
{% endfor %}
table inet infra_fw
delete table inet infra_fw

table inet infra_fw {
  chain input {
    type filter hook input priority 0; policy drop;

    ct state established,related accept
    ct state invalid drop
    iifname "lo" accept
    udp sport 67 udp dport 68 accept
    icmpv6 type { nd-router-solicit, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept

    # SSH
{% if firewall_ssh_anywhere and not restricted %}
    tcp dport 22 accept
{% elif ssh_ips | length > 0 %}
    ip saddr { {{ ssh_ips | unique | join(', ') }} } tcp dport 22 accept
{% endif %}
{% if proxy_enabled | default(false) | bool and 'bastion' in group_names %}

    # 프로젝트 VPC에서 배스천의 프록시 포트로 들어오는 연결만 허용한다.
    ip saddr { {{ proxy_client_cidrs | join(', ') }} } tcp dport {{ proxy_port }} accept
{% endif %}
{% if 'edge' in group_names and edge_https_allowed_cidrs | default([]) | length > 0 %}
    # HTTPS 사용자 범위. 값이 없으면 443은 닫힌 상태로 유지한다.
    ip saddr { {{ edge_https_allowed_cidrs | join(', ') }} } tcp dport 443 accept
{% endif %}
{% if restricted %}
    # Account 1의 서비스만 제한한다. 응답 패킷은 위 established 규칙에서 허용한다.
{% if 'game_frontend' in group_names or 'ad_frontend' in group_names %}
    tcp dport { 80, 443 } accept
{% else %}
{% set front_group = 'game_frontend' if 'game' in group_names else 'ad_frontend' %}
{% set front_ips = groups.get(front_group, []) | map('extract', hostvars, 'ip') | list %}
{% if front_ips | length > 0 %}
    ip saddr { {{ front_ips | join(', ') }} } tcp dport 8000 accept
{% endif %}
{% endif %}
{% endif %}
{% for g in group_names if g in firewall_rules and not restricted %}
{% set rule = firewall_rules[g] %}
{% set ips = [] %}
{% for src in rule.get('from', []) %}
{% for h in groups.get(src, []) %}
{% set _ = ips.append(hostvars[h].ip) %}
{% endfor %}
{% endfor %}
{% if rule.get('self', false) %}
{% for h in groups[g] %}
{% set _ = ips.append(hostvars[h].ip) %}
{% endfor %}
{% endif %}

    # {{ g }}
{% if ips | length > 0 %}
    ip saddr { {{ ips | unique | join(', ') }} } tcp dport 22 drop
    ip saddr { {{ ips | unique | join(', ') }} } accept
{% endif %}
{% if rule.get('tcp_ports_from_anywhere') %}
    tcp dport { {{ rule.tcp_ports_from_anywhere | join(', ') }} } accept
{% endif %}
{% endfor %}
  }
}
