# roles/spark 검증용 PySpark 작업 (client mode). 실패하면 예외로 비정상 종료한다.
import sys
from pyspark.sql import SparkSession

spark = SparkSession.builder.appName("infra-check").getOrCreate()
sc = spark.sparkContext

# 드라이버와 실행기(Worker)의 Python이 모두 3.12여야 한다.
assert sys.version_info[:2] == (3, 12), sys.version
executor_versions = set(sc.parallelize(range(6), 6).map(lambda _: __import__("sys").version_info[:2]).collect())
assert executor_versions == {(3, 12)}, executor_versions

# 실행기에서 계산이 돌아야 한다.
total = sc.parallelize(range(1000), 6).map(lambda x: x * 2).sum()
assert total == 999000, total

# 커넥터 JAR이 클래스패스에 있어야 한다.
loader = spark._jvm.java.lang.Thread.currentThread().getContextClassLoader()
for name in {{ spark_check_classes | to_json }}:
    loader.loadClass(name)

print("INFRA_SPARK_OK", total)
spark.stop()
