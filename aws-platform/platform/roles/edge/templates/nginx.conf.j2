# Ansible edge 역할이 관리한다. Front는 ACME 경로 외 HTTP 요청을 HTTPS로 보낸다.
user www-data;
worker_processes auto;
pid /run/nginx.pid;
error_log /var/log/nginx/error.log;
include /etc/nginx/modules-enabled/*.conf;
events { worker_connections 1024; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /var/log/nginx/access.log;
    sendfile on;
    server_tokens off;
    map $http_upgrade $edge_connection_upgrade {
        default upgrade;
        '' close;
    }
{% if edge_frontend_upstreams | length > 0 %}
    upstream edge_frontends {
        least_conn;
{% for frontend in edge_frontend_upstreams %}
        server {{ frontend.host }}:{{ frontend.port | default(80) }} max_fails=2 fail_timeout=10s;
{% endfor %}
    }
{% endif %}
    server {
        listen 80 default_server;
        server_name {{ edge_public_ip }}{% if edge_domain %} {{ edge_domain }}{% endif %};
        location ^~ /.well-known/acme-challenge/ {
            root {{ edge_acme_webroot }};
            default_type text/plain;
            try_files $uri =404;
        }
{% if edge_http_redirect | bool %}
        # 인증서 검증 경로를 제외한 HTTP 요청은 이 서버의 HTTPS로 이동한다.
        location / { return 308 https://{{ edge_domain or edge_public_ip }}$request_uri; }
{% else %}
        location / { return 404; }
{% endif %}
    }
{% if edge_tls_ready %}
{% if edge_domain %}
    # IP 접속은 앱을 제공하지 않고 정식 도메인으로 이동한다.
    server {
        listen 443 ssl default_server;
        server_name {{ edge_public_ip }};
        ssl_certificate /etc/letsencrypt/live/{{ edge_cert_name }}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/{{ edge_cert_name }}/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        return 308 https://{{ edge_domain }}$request_uri;
    }
{% endif %}
{% if not edge_domain or edge_domain_tls_ready %}
    server {
        listen 443 ssl{% if not edge_domain %} default_server{% endif %};
        # 서버별 요청 본문 제한: 광고 Front 3m, 기본 1m.
        client_max_body_size {{ edge_client_max_body_size }};
        server_name {{ edge_domain or edge_public_ip }};
        ssl_certificate /etc/letsencrypt/live/{{ edge_domain_cert_name if edge_domain else edge_cert_name }}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/{{ edge_domain_cert_name if edge_domain else edge_cert_name }}/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        # HTTPS 사용자 범위는 AWS SG와 동일하게 지정한다. 로컬 검증만 예외다.
        allow 127.0.0.1;
{% for cidr in edge_https_allowed_cidrs %}
        allow {{ cidr }};
{% endfor %}
        deny all;
{% if edge_domain %}
        # 현재 게임 Front의 정적 파일과 별도 Backend WebSocket 경로를 보존한다.
        location /static/ { alias {{ edge_static_root }}; }
        location /api/ads/ {
            default_type application/json;
            return 503 '{"error":"ads_disabled"}';
        }
        location /ws/campus/ {
            proxy_pass http://{{ edge_game_backend_host }}:{{ edge_game_backend_port }};
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $edge_connection_upgrade;
            proxy_read_timeout 3600s;
        }
{% endif %}
        location / {
{% if edge_frontend_upstreams | length > 0 %}
            proxy_pass http://edge_frontends;
            proxy_http_version 1.1;
            proxy_set_header Host {{ "$http_host" if edge_frontend_mode | bool else "$host" }};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $edge_connection_upgrade;
            proxy_connect_timeout 5s;
            proxy_read_timeout 3600s;
            proxy_next_upstream error timeout http_502 http_503 http_504;
{% else %}
            # return을 쓰면 접근 제한 전에 응답하므로 정적 파일로 제공한다.
            root {{ edge_setup_root }};
            index index.html;
            try_files $uri $uri/ =404;
{% endif %}
        }
    }
{% endif %}
{% endif %}
}
