# Ansible로 관리한다 (roles/spark).
[Unit]
Description=Apache Spark Master
After=network-online.target zookeeper.service
Wants=network-online.target

[Service]
User={{ spark_user }}
Group={{ spark_user }}
Environment=SPARK_HOME={{ spark_home }}
Environment=SPARK_CONF_DIR={{ spark_config_dir }}
ExecStart={{ spark_home }}/bin/spark-class org.apache.spark.deploy.master.Master --host {{ ip }} --port {{ spark_master_port }} --webui-port {{ spark_master_webui_port }}
StandardOutput=append:{{ spark_log_dir }}/master.log
StandardError=inherit
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
