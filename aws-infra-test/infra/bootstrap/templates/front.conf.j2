# 테스트 Front 한 대가 정적 파일과 앱 요청을 분기한다.
map $http_upgrade $test_connection_upgrade {
    default upgrade;
    '' close;
}
server {
    listen 80 default_server;
    server_name _;
{% for cidr in test_client_cidrs %}
    allow {{ cidr }};
{% endfor %}
    deny all;
    location = /healthz { return 200 'front ready\n'; }
    location /static/ { alias /srv/aws-infra-test/static/; }
    location /ads/ {
        proxy_pass http://{{ hostvars[groups['ad'][0]].ip }}:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location / {
        proxy_pass http://{{ hostvars[groups['game'][0]].ip }}:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $test_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }
}
