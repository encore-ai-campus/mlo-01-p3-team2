# Local development keeps SQLite unless you switch DATABASE_ENGINE to mysql.
DATABASE_ENGINE=sqlite

# Set these when using the team's operating MySQL database.
# DATABASE_ENGINE=mysql
# MYSQL_DATABASE=playdata_platform
# MYSQL_USER=platform_user
# MYSQL_PASSWORD=
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306

# Leave blank to retain raw events in event_outbox without Kafka delivery.
KAFKA_BOOTSTRAP_SERVERS=
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
CAMPUS_RAW_SOURCE=platform_server_1

# Existing product policy: fixed 8-hour maximum and 30-minute idle expiry.
CAMPUS_LOGIN_MAX_AGE_SECONDS=28800
CAMPUS_LOGIN_IDLE_TIMEOUT_SECONDS=1800

# Published Google Forms respondent URL for the rooftop event.
CAMPUS_RAFFLE_SURVEY_URL=https://docs.google.com/forms/d/e/1FAIpQLSf4dkDBcM-7uXtJNXjgsYUsstKRHDPUQ_M3WfCaZne_CUcIEA/viewform?usp=publish-editor

# Survey submissions are polled by the local server; Google connection is saved in the admin popup.
CAMPUS_RAFFLE_SURVEY_FORM_ID=117DNOSfnLfgmBkv-DkWruqjXKeuFQe--UbeeEg2L34c
CAMPUS_RAFFLE_SURVEY_POLL_SECONDS=10
CAMPUS_RAFFLE_SURVEY_REQUEST_TIMEOUT_SECONDS=20
