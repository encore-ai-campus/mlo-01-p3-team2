# Local Docker integration settings. Replace addresses/accounts for EC2 deployment.
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
SPARK_INPUT_TOPICS=standardized.account,standardized.chat,standardized.board,standardized.comment,standardized.content_usage,standardized.movement
SPARK_MASTER127.0.0.1:7077
SPARK_REGISTRY_FILE=contracts/registry.json
SPARK_CHECKPOINT_LOCATION=/opt/pipeline/artifacts/checkpoints/std-to-mysql
SPARK_STARTING_OFFSETS=earliest
SPARK_WRITE_PARTITIONS=3
SPARK_MAX_OFFSETS_PER_TRIGGER=1000
SPARK_TRIGGER_SECONDS=5
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=analysis_dev
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_WRITE_BATCH_SIZE=100
# Optional: MYSQL_SSL_CA, KAFKA_SASL_MECHANISM, KAFKA_SASL_JAAS_CONFIG,
# KAFKA_SSL_TRUSTSTORE_LOCATION, KAFKA_SSL_TRUSTSTORE_PASSWORD.
