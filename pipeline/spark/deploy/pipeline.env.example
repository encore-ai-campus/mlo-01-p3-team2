# Resolve the Kafka bootstrap and writable MySQL endpoint during deployment.
KAFKA_BOOTSTRAP_SERVERS=REPLACE_KAFKA_1:9092,REPLACE_KAFKA_2:9092,REPLACE_KAFKA_3:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
SPARK_INPUT_TOPICS=standardized.account,standardized.chat,standardized.board,standardized.comment,standardized.content_usage,standardized.movement,standardized.points
SPARK_MASTER=spark://10.30.10.113:7077,10.20.10.174:7077
SPARK_DRIVER_HOST=10.30.10.113
SPARK_REGISTRY_FILE=/opt/pipeline/spark/current/contracts/registry.json
SPARK_CHECKPOINT_LOCATION=/var/lib/spark-pipeline/checkpoints/std-to-mysql
SPARK_STARTING_OFFSETS=earliest
SPARK_WRITE_PARTITIONS=3
SPARK_MAX_OFFSETS_PER_TRIGGER=1000
SPARK_TRIGGER_SECONDS=5
MYSQL_HOST=REPLACE_WRITABLE_MYSQL_ENDPOINT
MYSQL_PORT=3306
MYSQL_DATABASE=analysis_user
MYSQL_USER=dev
MYSQL_WRITE_BATCH_SIZE=100
SPARK_PIPELINE_ROOT=/opt/pipeline/spark/current
SPARK_PIPELINE_PYTHON=/opt/pipeline/spark/.venv/bin/python
SPARK_SUBMIT=/opt/spark/bin/spark-submit
SPARK_PIPELINE_LOCAL_DIR=/var/lib/spark-pipeline/local
# MYSQL_PASSWORD is supplied only through the encrypted systemd credential.
