{
  "event_type": "quiz_answered",
  "schema_version": "1.1",
  "std_schema_version": "1.1",
  "fields": [
    {
      "name": "attempt_uuid",
      "nullable": false
    },
    {
      "name": "question_uuid",
      "nullable": false
    },
    {
      "name": "content_uuid",
      "nullable": false
    },
    {
      "name": "question_type",
      "nullable": false
    },
    {
      "name": "choice_uuid",
      "nullable": true
    },
    {
      "name": "is_correct",
      "nullable": false
    }
  ],
  "copy_fields": [
    "user_uuid",
    "session_uuid",
    "class_group_uuid",
    "attempt_uuid",
    "question_uuid",
    "content_uuid",
    "question_type",
    "choice_uuid",
    "is_correct"
  ],
  "conditional_rules": [
    {
      "when": {"question_type": "MULTIPLE_CHOICE"},
      "not_null": ["choice_uuid"]
    },
    {
      "when": {"question_type": "FILL_BLANK"},
      "null": ["choice_uuid"]
    }
  ],
  "constants": {
    "event_type": "QUIZ_ANSWERED"
  },
  "double_fields": []
}
