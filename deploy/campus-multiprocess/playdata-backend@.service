[Unit]
# 소켓 프로세스 하나(%i = 포트). 여러 개를 nginx(세션 고정 배정)가 :8000 으로 묶는다 — README.md
Description=Playdata campus socket process on port %i
After=network-online.target redis-server.service
Wants=network-online.target
Requires=redis-server.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/backend
# 지금의 playdata-backend 와 같은 값(.env 가 있으면 .env 가 이긴다)
Environment=PYTHONUNBUFFERED=1
Environment=DJANGO_DEBUG=0
EnvironmentFile=/home/ubuntu/backend/.env
# Redis 주소가 있어야 프로세스끼리 사람·채널 계층을 나눈다(.env 에 CAMPUS_REDIS_URL 을 두어도 된다)
Environment=CAMPUS_REDIS_URL=redis://127.0.0.1:6379/0
ExecStart=/home/ubuntu/backend/.venv/bin/daphne -b 127.0.0.1 -p %i config.asgi:application
Restart=always
RestartSec=2
UMask=0027

[Install]
WantedBy=multi-user.target
