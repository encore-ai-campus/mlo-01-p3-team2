[Unit]
Description=Playdata pending ad reaction delivery
After=network-online.target playdata-backend.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/backend
EnvironmentFile=/home/ubuntu/backend/.env
# 한 번 띄워 두고 5초마다 확인한다. 예전에는 타이머가 5초마다 새 Python 프로세스를 띄워 회당 CPU 약 1.1초를 썼다
ExecStart=/home/ubuntu/backend/.venv/bin/python manage.py dispatch_ad_reactions --poll-interval 5
# 명령은 SIGINT 를 받으면 진행 중인 요청의 결과를 저장한 뒤 끝난다(systemd 기본 SIGTERM 은 바로 끝낸다)
KillSignal=SIGINT
TimeoutStopSec=60
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
