# 운영 front-a 의 edge nginx(aws-platform/platform/roles/edge/templates/nginx.conf.j2 의 443 server)를 TLS 없이 흉내 낸다.
# EDGE_WS_UPSTREAM(run.py --edge): edge_frontends = 지금(WebSocket 도 프론트 중계로), nginx:8000 = WebSocket 만 game-server nginx 로 바로
# (deploy/campus-multiprocess/README.md §5). TLS 는 두 경우 모두 edge 가 같은 일을 하므로 뺐다.
map $http_upgrade $edge_connection_upgrade {
    default upgrade;
    '' close;
}

upstream edge_frontends {
    least_conn;
    server frontend:8004 max_fails=2 fail_timeout=10s;
}

server {
    listen 80;
    client_max_body_size 1m;
    location / {
        proxy_pass http://edge_frontends;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;  # 운영은 https
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $edge_connection_upgrade;
        proxy_connect_timeout 5s;
        proxy_read_timeout 3600s;
        proxy_next_upstream error timeout http_502 http_503 http_504;
    }
    location /ws/campus/ {
        proxy_pass http://${EDGE_WS_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $edge_connection_upgrade;
        proxy_connect_timeout 5s;
        proxy_read_timeout 3600s;
        proxy_next_upstream error timeout;
    }
}
