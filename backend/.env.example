# Backend owns auth, DB and Kafka. Include the public frontend host here.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-for-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Optional absolute path containing existing db.sqlite3 and var/.
# CAMPUS_DATA_DIR=C:/path/to/existing-data

# Local development keeps SQLite unless you switch DATABASE_ENGINE to mysql.
DATABASE_ENGINE=sqlite

# Set these when using the team's operating MySQL database.
# DATABASE_ENGINE=mysql
# MYSQL_DATABASE=playdata_platform
# MYSQL_USER=platform_user
# MYSQL_PASSWORD=
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306

# Empty outbox polling backs off to this interval; local commits wake it immediately.
CAMPUS_OUTBOX_IDLE_POLL_SECONDS=5
# Only the MySQL Kafka publisher thread reuses a connection. HTTP/WS keep max age 0.
CAMPUS_OUTBOX_CONNECTION_MAX_AGE_SECONDS=60

# Leave blank to retain raw events in event_outbox without Kafka delivery.
KAFKA_BOOTSTRAP_SERVERS=
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
CAMPUS_RAW_SOURCE=platform_server_1

# Actual rewards for each correct answer; restart the backend after changes.
LEARNING_POINTS_BEGINNER=20
LEARNING_POINTS_INTERMEDIATE=50
LEARNING_POINTS_ADVANCED=80

# Existing product policy: fixed 8-hour maximum and 30-minute idle expiry.
CAMPUS_LOGIN_MAX_AGE_SECONDS=28800
CAMPUS_LOGIN_IDLE_TIMEOUT_SECONDS=1800

# Private mailbox for registered accounts. Enable after migrations.
CAMPUS_DM_ENABLED=0

# 광고 서버와 슬롯을 준비한 뒤 활성화한다.
ADS_ENABLED=0
ADS_API_BASE_URL=
ADS_MEDIA_KEY=
# 별도 포털 매체 사용 시 두 항목을 함께 설정한다. 과거 슬롯 ID도 목록에 남긴다.
ADS_PORTAL_MEDIA_KEY=
ADS_PORTAL_MEDIA_SLOT_IDS=
ADS_SUBJECT_SECRET=
ADS_API_TIMEOUT=1
# 옥상은 shared, 포털 좌우는 individual 슬롯 UUID를 사용한다.
ADS_ROOFTOP_SLOT_ID=
ADS_PORTAL_LEFT_SLOT_ID=
ADS_PORTAL_RIGHT_SLOT_ID=
