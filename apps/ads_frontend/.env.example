# 광고 서버 프론트 환경값(설계 §6.6 "6-15 분리"). 복사해서 .env 로 쓴다.
FRONTEND_DEBUG=1
# 운영(FRONTEND_DEBUG=0)에서는 필수: python -c "import secrets; print(secrets.token_urlsafe(60))"
FRONTEND_SECRET_KEY=
# 사용자가 여는 호스트(쉼표로 여럿). 백엔드의 ALLOWED_HOSTS 에도 같은 호스트가 있어야 한다 — Host 를 그대로 넘긴다
FRONTEND_ALLOWED_HOSTS=localhost,127.0.0.1
# 백 서버의 광고 서버 Django(http://주소:포트, 경로 없이)
BACKEND_URL=http://127.0.0.1:8000
BACKEND_TIMEOUT=30
# 관리 사이트 경로 — 백엔드의 ADMIN_URL_PATH 와 같아야 한다(운영은 기본값 금지)
ADMIN_URL_PATH=dev-admin/
# 정적 파일을 모을 폴더(collectstatic). 운영은 모은 뒤 재시작
STATIC_ROOT=
