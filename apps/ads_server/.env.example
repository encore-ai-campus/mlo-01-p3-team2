# 이 파일을 .env 로 복사해서 쓴다. .env 는 커밋하지 않는다(권한 600 권장).
# 실제 환경변수(인프라가 주입한 값)가 .env 보다 우선한다.

# 설정 모듈(DJANGO_SETTINGS_MODULE)은 여기에 적지 않는다. manage.py 는 기본 dev, 웹(wsgi·asgi)은 .env 를 따르지 않고 실제 환경변수가 없으면 prod 다.
# 운영 호스트에서 manage.py 명령(migrate·process_reactions·relay_events 등)은 실제 환경변수로 DJANGO_SETTINGS_MODULE=config.settings.prod 를 지정한다.

# prod 필수. 50자 이상 무작위 문자열. dev 에서는 비우면 임시 키를 쓴다.
SECRET_KEY=

# dev 에서만 의미가 있다(prod 는 항상 꺼짐). 1 이면 켠다.
DJANGO_DEBUG=0

# 쉼표로 구분. prod 필수.
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL 8.4 접속 (dev·test·prod 모두). 시험은 `test_<DB_NAME>` 을 만들고 지우므로 CREATE/DROP 권한이 필요하다.
# 로컬 시험용 컨테이너: intake/db-standalone (README "MySQL 시험 환경"). DB_USER/DB_PASSWORD 는 필수, prod 는 DB_NAME·DB_HOST 도 필수.
DB_NAME=ads_server
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# MongoDB 8.0 이벤트 저장소. 웹은 쓰지 않으므로 웹 노드는 비워 둬도 기동한다. 중계(relay_events)는 설정이 없으면 바로 멈춘다(6-3e). 확인: `python manage.py check_event_store`
# 레플리카셋이면 구성원 주소를 쉼표로 적고 MONGO_REPLICA_SET 에 이름을 적는다. 비밀번호는 URI 가 아니라 따로 둔다.
MONGO_HOSTS=127.0.0.1:27017
MONGO_DB=ads_events
MONGO_USER=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin
# MONGO_REPLICA_SET=rs0

# Django admin 경로. 앞 슬래시 없이 `이름/` 형태. prod 는 필수이며 기본값 admin/ 은 금지(추측하기 어려운 값을 쓴다).
ADMIN_URL_PATH=dev-admin/

# 소재 이미지 저장 폴더(코드·정적 경로 밖). prod 필수. dev 기본은 ./media
MEDIA_ROOT=
# 광고 서버의 공개 주소(결정 응답의 image_url 에 쓴다). prod 필수.
ASSET_PUBLIC_BASE_URL=http://127.0.0.1:8001
# `collectstatic` 결과 폴더. 운영에서는 Django 가 WhiteNoise 로 서빙한다(시작할 때 읽으므로 모은 뒤 재시작). 기본 ./staticfiles
STATIC_ROOT=
# 업로드 용량 상한(바이트). 기본 2097152(2MB). 1~2MB 범위에서 정한다.
ASSET_MAX_BYTES=2097152

# HTTPS(TLS·80→443 리다이렉트·HSTS)는 앞단 nginx 가 맡고 Django 는 HTTP 로 받는다(설계 §10 "배포 구성").
# prod 필수: 브라우저가 여는 https 주소(예: https://ads.example.com, 쉼표로 구분). 없으면 로그인 POST 가 CSRF 출처 검사에서 막힌다.
CSRF_TRUSTED_ORIGINS=

# 신뢰할 프록시 수. prod 는 필수이고 1 이상이다(앞단 nginx 뒤 = 1, 없거나 0 이하면 기동하지 않는다).
# dev(로컬 runserver)는 0 — X-Forwarded-For 를 신뢰하지 않는다.
TRUSTED_PROXY_COUNT=0

# 가입 지급 포인트(정수). 기본 50000.
SIGNUP_GRANT_POINTS=50000
# 예산 "그날"의 경계(시간). 0 = UTC 자정(KST 09:00 리셋), 9 = KST 자정. 바꾸면 `python manage.py recompute_spend` 를 실행한다.
BUDGET_DAY_OFFSET_HOURS=0
