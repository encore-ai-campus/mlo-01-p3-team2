# 이 파일을 .env 로 복사해서 쓴다. .env 는 커밋하지 않는다(권한 600 권장).
# 실제 환경변수(인프라가 주입한 값)가 .env 보다 우선한다.

DJANGO_SETTINGS_MODULE=config.settings.dev

# prod 필수. 50자 이상 무작위 문자열. dev 에서는 비우면 임시 키를 쓴다.
SECRET_KEY=

# dev 에서만 의미가 있다(prod 는 항상 꺼짐). 1 이면 켠다.
DJANGO_DEBUG=0

# 쉼표로 구분. prod 필수.
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite 파일 경로. prod 는 필수(절대 경로 권장).
DATABASE_PATH=db.sqlite3

# Django admin 경로. 앞 슬래시 없이 `이름/` 형태. prod 는 필수이며 기본값 admin/ 은 금지(추측하기 어려운 값을 쓴다).
ADMIN_URL_PATH=dev-admin/

# 소재 이미지 저장 폴더(코드·정적 경로 밖). prod 필수. dev 기본은 ./media
MEDIA_ROOT=
# 광고 서버의 공개 주소(결정 응답의 image_url 에 쓴다). prod 필수.
ASSET_PUBLIC_BASE_URL=http://127.0.0.1:8001
# `collectstatic` 결과 폴더(운영 웹서버가 서빙). 기본 ./staticfiles
STATIC_ROOT=
# 업로드 용량 상한(바이트). 기본 2097152(2MB). 1~2MB 범위에서 정한다.
ASSET_MAX_BYTES=2097152

# prod HTTPS 설정. TLS 종단이 프록시면 BEHIND_TLS_PROXY=1 (프록시가 X-Forwarded-Proto 를 덮어쓸 때만).
SSL_REDIRECT=1
BEHIND_TLS_PROXY=0
HSTS_SECONDS=3600
# 예: https://ads.example.com (쉼표로 구분)
CSRF_TRUSTED_ORIGINS=

# 리버스 프록시 뒤에 둘 때만 신뢰할 프록시 수를 적는다. 0 이면 X-Forwarded-For 를 신뢰하지 않는다.
TRUSTED_PROXY_COUNT=0
