# InnoDB Cluster(그룹 복제, 단일 primary) 노드의 서버 설정. AdminAPI(dba.configureInstance)가 요구하는 것을 미리 갖춰 둬서 재시작 없이 구성한다.
[mysqld]
basedir=/opt/mysql
datadir=/var/lib/mysql
socket=/var/run/mysqld/mysqld.sock
bind-address=0.0.0.0
log-error=stderr

# 그룹 복제 필수 조건
gtid_mode=ON
enforce_gtid_consistency=ON
binlog_format=ROW
log_bin=binlog
log_replica_updates=ON
binlog_checksum=NONE
disabled_storage_engines="MyISAM,BLACKHOLE,FEDERATED,ARCHIVE,MEMORY"
# 인프라의 기본(utf8mb4, strict)과 맞춘다. 연결 수(max_connections)는 기본값(151)을 그대로 둔다 — 운영 값이 정해지면 바꾼다(계획 7.3.4 #4)
character_set_server=utf8mb4
innodb_buffer_pool_size=256M
# 커밋마다 로그를 디스크에: 확인한(2xx) 쓰기는 잃지 않는다는 약속의 일부
innodb_flush_log_at_trx_commit=1
sync_binlog=1

# ([client] 소켓을 두지 않는다: 두면 MySQL Shell 이 시작할 때 소켓으로 자동 접속하려다 실패한다. mysqladmin 은 --socket 으로 부른다)
